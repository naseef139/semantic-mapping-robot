<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mallbot_perception</name>
  <version>0.1.0</version>
  <description>Object-level semantic notes for MallBot: YOLO-World detections + depth -> map positions -> confirmed notes (people filtered out).</description>
  <maintainer email="60naseef2@gmail.com">M.N.A. Naseef</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- ultralytics (YOLO / YOLO-World) is installed with pip: see README.md -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
