<?xml version="1.0"?>
<!--
  Gazebo (Ignition Fortress) plugins and sensors for MallBot.
  Topics published inside Gazebo (bridged to ROS 2 by the launch file):
    /scan                LaserScan     (2D LiDAR)
    /camera/image        Image         (RGB)
    /camera/depth_image  Image         (depth, 32FC1 metres)
    /camera/camera_info  CameraInfo
    /imu                 Imu
    /odom, /tf           wheel odometry (odom -> base_footprint)
    /joint_states        wheel joint states
  Subscribed:
    /cmd_vel_safe        Twist  (cmd_vel_timeout node: /cmd_vel -> /cmd_vel_safe, zero after 0.7 s silence)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===== Differential drive + joint states ===== -->
  <gazebo>
    <plugin filename="ignition-gazebo-diff-drive-system"
            name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <max_linear_acceleration>0.5</max_linear_acceleration>
      <min_linear_acceleration>-0.5</min_linear_acceleration>
      <max_angular_acceleration>1.5</max_angular_acceleration>
      <min_angular_acceleration>-1.5</min_angular_acceleration>
      <max_linear_velocity>0.34</max_linear_velocity>  <!-- 100 rpm x 65 mm wheel -->
      <min_linear_velocity>-0.34</min_linear_velocity>
      <max_angular_velocity>1.2</max_angular_velocity>
      <min_angular_velocity>-1.2</min_angular_velocity>
      <topic>/cmd_vel_safe</topic>   <!-- from cmd_vel_timeout node, not raw /cmd_vel -->
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>

    <plugin filename="ignition-gazebo-joint-state-publisher-system"
            name="ignition::gazebo::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>

  <!-- ===== 2D LiDAR (RPLIDAR A2M12 class: 360 deg, 0.2-12 m, 10 Hz) ===== -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <ignition_frame_id>lidar_link</ignition_frame_id>
      <topic>/scan</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.20</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
    </sensor>
  </gazebo>

  <!-- ===== RGB-D camera (OAK-D Pro W class: wide FOV, 640x400) ===== -->
  <gazebo reference="camera_link">
    <sensor name="rgbd_camera" type="rgbd_camera">
      <ignition_frame_id>camera_optical_frame</ignition_frame_id>
      <topic>/camera</topic>
      <update_rate>15</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.66</horizontal_fov>  <!-- ~95 deg -->
        <image>
          <width>640</width>
          <height>400</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>20.0</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.2</near>
            <far>12.0</far>
          </clip>
        </depth_camera>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

  <!-- ===== IMU ===== -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <ignition_frame_id>imu_link</ignition_frame_id>
      <topic>/imu</topic>
      <update_rate>100</update_rate>
      <always_on>true</always_on>
    </sensor>
  </gazebo>

</robot>
