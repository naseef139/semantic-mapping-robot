<?xml version="1.0"?>
<!--
  MallBot - custom differential-drive robot for
  "Online Object-Level Semantic Mapping During Autonomous Exploration"

  Sensors (matching the real robot):
    - 2D LiDAR (RPLIDAR A2M12 class), scan plane 0.30 m above the floor
    - RGB-D camera (OAK-D Pro W class), lens 0.50 m above the floor, not tilted
    - IMU at the base, wheel odometry from the drive plugin
  Layout (Nova Carter style): 2 drive wheels at the front, 2 swivel casters at the rear corners.

  All key dimensions are parameters below - change them to match the real chassis.
  Frames: base_footprint (on the floor) -> base_link (wheel axle height) -> sensors
-->
<robot name="mallbot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================= PARAMETERS (edit to match the real robot) ================= -->
  <xacro:property name="PI" value="3.14159265359"/>

  <!-- Chassis = 315 x 235 x 110 enclosure on a 5 mm base plate (CAD: mallbot_cad) -->
  <xacro:property name="base_length" value="0.315"/>
  <xacro:property name="base_width" value="0.235"/>
  <xacro:property name="base_height" value="0.115"/>     <!-- plate 5 mm + box 110 mm -->
  <xacro:property name="ground_clearance" value="0.0475"/> <!-- plate underside -->
  <xacro:property name="base_mass" value="3.0"/>

  <!-- Drive wheels -->
  <xacro:property name="wheel_radius" value="0.0325"/>    <!-- 65 mm wheel -->
  <xacro:property name="wheel_width" value="0.027"/>
  <xacro:property name="wheel_separation" value="0.28"/>   <!-- track, centre to centre (CAD) -->
  <xacro:property name="wheel_x_offset" value="0.0"/>      <!-- base_link IS the drive axle centre -->

  <!-- Nova Carter layout: drive axle at the FRONT, 2 swivel casters at the REAR corners.
       base_link sits on the drive axle (the point the robot turns about).
       body_x = where the chassis centre is, measured from the axle (CAD: axle at +90 mm). -->
  <xacro:property name="body_x" value="-0.09"/>
  <xacro:property name="wheel_mass" value="0.2"/>

  <!-- Rear swivel casters (frictionless spheres in simulation). x, y in CHASSIS coordinates -->
  <xacro:property name="caster_radius" value="0.0125"/>   <!-- 1 inch caster wheel -->
  <xacro:property name="caster_x" value="-0.12"/>
  <xacro:property name="caster_y" value="0.08"/>

  <!-- Sensor heights ABOVE THE FLOOR -->
  <xacro:property name="lidar_height" value="0.2305"/>     <!-- scan plane (lid 162.5 + riser 40 + 28) -->
  <xacro:property name="lidar_x" value="-0.01"/>            <!-- chassis coordinates -->
  <xacro:property name="camera_height" value="0.60"/>      <!-- lens centre (BOM target) -->
  <xacro:property name="camera_x" value="-0.065"/>          <!-- chassis coordinates -->
  <xacro:property name="camera_pitch" value="0.0"/>        <!-- tilt mount: 0 to -0.35 rad (0-20 deg up); negative = nose up -->
  <xacro:property name="mast_x" value="-0.12"/>        <!-- 110 mm behind the LiDAR -->

  <!-- Derived values -->
  <xacro:property name="base_top" value="${ground_clearance + base_height}"/>  <!-- from floor -->

  <!-- ================= INERTIA MACROS ================= -->
  <xacro:macro name="box_inertia" params="m x y z ox:=0 oz:=0">
    <inertial>
      <origin xyz="${ox} 0 ${oz}"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0"
               iyy="${m*(x*x+z*z)/12}" iyz="0"
               izz="${m*(x*x+y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0"
               iyy="${m*(3*r*r+h*h)/12}" iyz="0"
               izz="${m*r*r/2}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${2*m*r*r/5}" ixy="0" ixz="0"
               iyy="${2*m*r*r/5}" iyz="0"
               izz="${2*m*r*r/5}"/>
    </inertial>
  </xacro:macro>

  <!-- ================= MATERIALS ================= -->
  <material name="dark_grey"><color rgba="0.2 0.2 0.22 1"/></material>
  <material name="black"><color rgba="0.05 0.05 0.05 1"/></material>
  <material name="blue"><color rgba="0.15 0.35 0.75 1"/></material>
  <material name="silver"><color rgba="0.7 0.7 0.72 1"/></material>

  <!-- ================= BASE ================= -->
  <link name="base_footprint"/>

  <link name="base_link">
    <!-- chassis box: bottom at ground_clearance, base_link sits at axle height -->
    <visual>
      <origin xyz="${body_x} 0 ${ground_clearance + base_height/2 - wheel_radius}"/>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="${body_x} 0 ${ground_clearance + base_height/2 - wheel_radius}"/>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
    </collision>
    <!-- mass centred on the chassis (behind the axle) so the rear casters carry load -->
    <xacro:box_inertia m="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}"
                       ox="${body_x}" oz="${ground_clearance + base_height/2 - wheel_radius}"/>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}"/>
  </joint>

  <!-- ================= DRIVE WHEELS ================= -->
  <xacro:macro name="wheel" params="side y_sign">
    <link name="${side}_wheel_link">
      <visual>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="black"/>
      </visual>
      <!-- SPHERE collision: one contact point at exactly y = +/- track/2.
           A cylinder touches the floor at its edges in Gazebo (DART), which changes the
           effective track during in-place turns -> wrong odometry yaw -> broken map. -->
      <collision>
        <geometry><sphere radius="${wheel_radius}"/></geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <!-- Rotated so the joint z-axis points to the robot's left: positive = forward for both wheels -->
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="${wheel_x_offset} ${y_sign*wheel_separation/2} 0" rpy="${-PI/2} 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>

    <gazebo reference="${side}_wheel_link">
      <mu1>1.5</mu1>
      <mu2>1.5</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:wheel side="left" y_sign="1"/>
  <xacro:wheel side="right" y_sign="-1"/>

  <!-- ================= CASTERS (frictionless spheres) ================= -->
  <xacro:macro name="caster" params="name x y">
    <link name="${name}_caster_link">
      <visual>
        <geometry><sphere radius="${caster_radius}"/></geometry>
        <material name="silver"/>
      </visual>
      <collision>
        <geometry><sphere radius="${caster_radius}"/></geometry>
      </collision>
      <xacro:sphere_inertia m="0.1" r="${caster_radius}"/>
    </link>
    <joint name="${name}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_caster_link"/>
      <origin xyz="${body_x + x} ${y} ${caster_radius - wheel_radius}"/>
    </joint>
    <gazebo reference="${name}_caster_link">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:caster name="rear_left" x="${caster_x}" y="${caster_y}"/>
  <xacro:caster name="rear_right" x="${caster_x}" y="${-caster_y}"/>

  <!-- ================= LIDAR (stand + sensor) ================= -->
  <!-- Stand from chassis top up to the bottom of the LiDAR body -->
  <xacro:property name="lidar_body_h" value="0.041"/>
  <xacro:property name="lidar_stand_h" value="${lidar_height - lidar_body_h/2 - base_top}"/>

  <link name="lidar_stand_link">
    <visual>
      <geometry><cylinder radius="0.02" length="${lidar_stand_h}"/></geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.02" length="${lidar_stand_h}"/></geometry>
    </collision>
    <xacro:cylinder_inertia m="0.1" r="0.02" h="${lidar_stand_h}"/>
  </link>
  <joint name="lidar_stand_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_stand_link"/>
    <origin xyz="${body_x + lidar_x} 0 ${base_top + lidar_stand_h/2 - wheel_radius}"/>
  </joint>

  <!-- lidar_link origin = scan plane centre -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.038" length="${lidar_body_h}"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.038" length="${lidar_body_h}"/></geometry>
    </collision>
    <xacro:cylinder_inertia m="0.19" r="0.038" h="${lidar_body_h}"/>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${body_x + lidar_x} 0 ${lidar_height - wheel_radius}"/>
  </joint>

  <!-- ================= CAMERA MAST + RGB-D CAMERA ================= -->
  <xacro:property name="mast_h" value="${camera_height - 0.02 - base_top}"/>

  <link name="mast_link">
    <visual>
      <geometry><cylinder radius="0.015" length="${mast_h}"/></geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.015" length="${mast_h}"/></geometry>
    </collision>
    <xacro:cylinder_inertia m="0.3" r="0.015" h="${mast_h}"/>
  </link>
  <joint name="mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mast_link"/>
    <origin xyz="${body_x + mast_x} 0 ${base_top + mast_h/2 - wheel_radius}"/>
  </joint>

  <!-- camera_link: x forward (Gazebo/ROS body convention) -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.035 0.11 0.035"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry><box size="0.035 0.11 0.035"/></geometry>
    </collision>
    <xacro:box_inertia m="0.15" x="0.035" y="0.11" z="0.035"/>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${body_x + camera_x} 0 ${camera_height - wheel_radius}" rpy="0 ${camera_pitch} 0"/>
  </joint>

  <!-- camera_optical_frame: z forward, x right, y down (what images and depth use) -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-PI/2} 0 ${-PI/2}"/>
  </joint>

  <!-- ================= IMU ================= -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${base_top - wheel_radius - 0.01}"/>
  </joint>

  <!-- ================= GAZEBO PLUGINS AND SENSORS ================= -->
  <xacro:include filename="mallbot.gazebo.xacro"/>

</robot>
